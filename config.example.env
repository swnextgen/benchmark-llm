# Choose edge or advanced. The RAM-based suggestion is used when omitted.
BENCHMARK_PROFILE=advanced
# performance, tasks (capability), both (complete), or quick (Advanced only:
# 4 SWE + 4 Terminal + 2 LiveBench easiest tasks + performance, about 60 min)
BENCHMARK_TYPE=both

# Advanced Systems Benchmark
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_MODEL=/models/example
# Optional report label; defaults to the final component of OPENAI_MODEL.
OPENAI_MODEL_DISPLAY_NAME=Example Model

# Edge Device Benchmark: local files, no API server required.
# Set BENCHMARK_PROFILE=edge above to use these settings.
# EDGE_MODEL=/home/pi/NVIDIA-Nemotron-3-Nano-4B-Q4_K_M.gguf
# EDGE_BINARY=/home/pi/prism-llama.cpp/build/bin/llama-completion
# EDGE_THREADS=8
# EDGE_CONTEXT_TOKENS=4096
