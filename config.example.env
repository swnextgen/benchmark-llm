# Choose edge or advanced. The RAM-based suggestion is used when omitted.
BENCHMARK_PROFILE=advanced
# performance, tasks (capability), or both (complete)
BENCHMARK_TYPE=both

# Advanced Systems Benchmark
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_MODEL=/models/example
# Optional report label; defaults to the final component of OPENAI_MODEL.
OPENAI_MODEL_DISPLAY_NAME=Example Model

# Edge Device Benchmark
# EDGE_BASE_URL=http://127.0.0.1:8080/v1
# EDGE_MODEL=/models/example
# EDGE_RUNTIME_NAME=llama.cpp
